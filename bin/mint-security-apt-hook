#!/usr/bin/env python3
"""Hook APT (Pre-Install-Pkgs e Post-Invoke) para revalidação de confiança por SHA-256."""

from __future__ import annotations

import json
import sys
from pathlib import Path

repo_src = Path(__file__).resolve().parents[1] / "src"
if repo_src.is_dir():
    sys.path.insert(0, str(repo_src))

from mintsec.firewall_trust import AptTrustHookProcessor, TrustStore  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    args = argv if argv is not None else sys.argv[1:]
    if not args:
        return 0
    mode = args[0]
    store = TrustStore()
    processor = AptTrustHookProcessor(store)
    if mode == "pre-install":
        deb_paths = [line.strip() for line in sys.stdin if line.strip().endswith(".deb")]
        out = processor.pre_install_pkgs(deb_paths)
        print(json.dumps(out, ensure_ascii=False))
        return 0
    if mode == "post-invoke":
        out = processor.post_invoke()
        print(json.dumps(out, ensure_ascii=False))
        return 0
    return 1


if __name__ == "__main__":
    sys.exit(main())
