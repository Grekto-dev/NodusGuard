[Unit]
Description=Suíte de Segurança Mint — Histórico SQLite WAL opcional (sem capacidades)

[Service]
Type=simple
ExecStart=/usr/bin/mint-security-daemon --history-only --idle-exit-secs 30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
CapabilityBoundingSet=
AmbientCapabilities=
MemoryHigh=128M
Restart=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
LockPersonality=yes
RestrictRealtime=yes
ProtectControlGroups=yes
