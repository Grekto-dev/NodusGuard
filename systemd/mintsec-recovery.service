[Unit]
Description=Suíte de Segurança Mint — Serviço de Recuperação e Cópias (sob demanda)

[Service]
Type=dbus
BusName=org.mintsecurity.Recovery
ExecStart=/usr/bin/mint-security-daemon --module recovery --idle-exit-secs 30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/tmp /etc/timeshift /var/lib/mint-security-suite
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=
MemoryHigh=768M
Restart=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
LockPersonality=yes
RestrictRealtime=yes
ProtectControlGroups=yes
StateDirectory=mint-security-suite
StateDirectoryMode=0700
