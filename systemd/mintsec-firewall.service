[Unit]
Description=Suíte de Segurança Mint — Serviço de Firewall (sob demanda)

[Service]
Type=dbus
BusName=org.mintsecurity.Firewall
ExecStart=/usr/bin/mint-security-daemon --module firewall --idle-exit-secs 30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/etc/ufw /var/lib/mint-security-suite
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE
AmbientCapabilities=
MemoryHigh=128M
Restart=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
LockPersonality=yes
RestrictRealtime=yes
ProtectControlGroups=yes
StateDirectory=mint-security-suite
StateDirectoryMode=0700
Environment=XDG_CONFIG_HOME=/var/lib/mint-security-suite XDG_DATA_HOME=/var/lib/mint-security-suite XDG_STATE_HOME=/var/lib/mint-security-suite
