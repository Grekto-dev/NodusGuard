[Unit]
Description=Suíte de Segurança Mint — Serviço de Isolamento e Atualizações

[Service]
Type=dbus
BusName=org.mintsecurity.Isolation
ExecStart=/usr/bin/mint-security-daemon --module isolation --idle-exit-secs 30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
CapabilityBoundingSet=
MemoryHigh=128M
Restart=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
LockPersonality=yes
RestrictRealtime=yes
ProtectControlGroups=yes
