[Unit]
Description=Suíte de Segurança Mint — Serviço de Resgate Offline (UDisks2)

[Service]
Type=dbus
BusName=org.mintsecurity.Rescue
ExecStart=/usr/bin/mint-security-daemon --module rescue --idle-exit-secs 30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/mint-security-suite
CapabilityBoundingSet=
MemoryHigh=128M
Restart=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
LockPersonality=yes
RestrictRealtime=yes
ProtectControlGroups=yes
StateDirectory=mint-security-suite
StateDirectoryMode=0700
Environment=XDG_CONFIG_HOME=/var/lib/mint-security-suite XDG_DATA_HOME=/var/lib/mint-security-suite XDG_STATE_HOME=/var/lib/mint-security-suite
