[Unit]
Description=Suíte de Segurança Mint — Serviço de Resgate Offline (UDisks2)

[Service]
Type=dbus
BusName=org.mintsecurity.Rescue
ExecStart=/usr/bin/mint-security-daemon --module rescue --idle-exit-secs 30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
CapabilityBoundingSet=
MemoryHigh=128M
Restart=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
LockPersonality=yes
RestrictRealtime=yes
ProtectControlGroups=yes
